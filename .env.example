PORT=3000

# --- Supabase (Local con Supabase CLI o Remoto) ---
SUPABASE_URL=http://127.0.0.1:54321
# Debe ser la service_role key (el backend escribe en Storage y en las tablas sin sesión de usuario)
SUPABASE_KEY=tu-service-role-key-aqui

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=tu_secreto_telegram_aqui
# Valida el header X-Telegram-Bot-Api-Secret-Token. Solo letras, números, "_" y "-" (máx. 256)
TELEGRAM_WEBHOOK_SECRET=tu_secreto_webhook_aqui
# SIREP-S3-T03: Lista de chat_id numéricos o usernames autorizados (ej. David y Valentino), separados por coma.
TELEGRAM_CHATS_AUTORIZADOS=david,valentino
# URL pública https del backend, sin /telegram/webhook (la usa `npm run telegram:webhook`)
# En local: la URL que entrega ngrok o cloudflared
PUBLIC_URL=https://tu-dominio-o-tunel.example.com

# --- Autenticación y Seguridad de la Bandeja (SIREP-S3-T04) ---
AUTH_JWT_SECRET=cambia_este_secreto_jwt_en_produccion
# Formato opcional para usuarios locales/operativos: usuario:contraseña:Nombre Visible:rol
AUTH_USUARIOS=david:cambiar_clave_1:David:operador,valentino:cambiar_clave_2:Valentino:revisor

# --- Proveedor de IA Activo (gemini | openai | anthropic) (SIREP-S3-T16) ---
IA_PROVEEDOR=gemini
IA_MODELO=gemini-3.8-flash
IA_TEMPERATURA=0.1
IA_PROMPT=
IA_PROMPT_ARCHIVO=

# Google Gemini (Predeterminado)
GEMINI_API_KEY=tu_secreto_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
# Intentos totales cuando Gemini responde 503/429 (sobrecarga) y espera inicial en ms, que se duplica en cada reintento.
# Con 5 intentos y 2000 ms el bot espera hasta 2+4+8+16 = 30 s antes de rendirse
GEMINI_REINTENTOS=5
GEMINI_ESPERA_MS=2000

# OpenAI (Para pruebas de viabilidad comparativas)
OPENAI_API_KEY=tu_secreto_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (Tercer proveedor comparativo — SIREP-S3-T16)
ANTHROPIC_API_KEY=tu_secreto_anthropic_aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Procesamiento de escaneos ---
# Resolución a la que se convierte cada página del PDF en imagen
PDF_DPI=200
# Máximo de páginas por PDF (anverso y reverso = 2). Evita un costo de IA inesperado si envían un PDF largo
MAX_PAGINAS_REPORTE=10
# Páginas de un PDF que la IA lee a la vez (no cambia la precisión, solo el tiempo)
IA_PAGINAS_EN_PARALELO=2
# Tamaño máximo (MB) de un archivo subido desde la página web
MAX_MB_ESCANEO=10
# Lado largo (px) de la copia comprimida que se envía al modelo. 1600 es el valor de SIREGG;
# para manuscrito se ajusta con la prueba de viabilidad
IA_LADO_LARGO_PX=1600
# Experimentos SIREP-S3-T17: preprocesamiento (contraste y nitidez) y prompt por secciones
IA_PREPROCESAR_IMAGEN=false
IA_NORMALIZAR_CONTRASTE=false
IA_NITIDEZ=false
IA_PROMPT_SECCIONES=false
# SIREP-S3-T18: Primeros N reportes en producción se marcan completos para revisión campo por campo
REVISION_COMPLETA_PRIMEROS_N=30

# --- CORS (Frontend / Bandeja de revisión) ---
FRONTEND_URL=http://localhost:3001,http://localhost:5173

# --- Envío del histórico a RP-TECH (docs/contrato-historico.md) ---
# URL de la función importar-historico de RP-TECH y la clave propia de SIREP.
# La clave la entrega RP-TECH por privado; nunca se sube al repo.
RPTECH_URL=
RPTECH_CLAVE=
# El envío es manual: botón "Enviar" o "Enviar completados a RP-TECH" en la bandeja.

# --- Configuración del bot desde la app (Configuración → Bot de Telegram) ---
# Roles que pueden cambiar la dirección del bot o desconectarlo (los demás solo ven el estado).
BOT_CONFIG_ROLES=admin,operador
