PORT=3000

# --- Supabase (Local con Supabase CLI o Remoto) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=tu-service-role-key-aqui

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCDefgh...
# Token secreto para validar el webhook en header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=tu_secreto_webhook_aqui

# --- Proveedor de IA Activo (gemini | openai) ---
IA_PROVIDER=gemini

# Google Gemini (Predeterminado)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Para pruebas de viabilidad comparativas)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# --- CORS (Frontend / Bandeja de revisión) ---
FRONTEND_URL=http://localhost:3000,http://localhost:5173
